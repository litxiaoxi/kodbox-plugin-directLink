{
	"id":"dl",
	"name":"{{LNG['dl.meta.name']}}",
	"title":"{{LNG['dl.meta.title']}}",
	"version":"1.0.5",
	"source":{
		"className":"font-icon ri-link-m bg-blue-6"
	},
	"category":"file,share",
	"description":"{{LNG['dl.meta.desc']}}",
	"keywords":"direct link,share",
	"auther":{
		"copyright":"Litx",
		"homePage":"https://litx.cn"
	},
	"configItem":{
		"pluginAuth":{
			"type":"userSelect",
			"value":{"all":1},
			"display":"{{LNG['admin.plugin.auth']}}",
			"desc":"{{LNG['dl.config.pluginAuthDesc']}}",
			"require":1
		},
		"openWith":{
			"type":"segment",
			"value":"inline",
			"display":"{{LNG['admin.plugin.openWith']}}",
			"info":{
				"inline":"<i class='font-icon ri-layout-left-line-2'></i>{{LNG['explorer.app.openInline']}}",
				"dialog":"<i class='font-icon ri-picture-in-picture-fill'></i>{{LNG['explorer.app.openDialog']}}",
				"_blank":"<i class='font-icon ri-external-link-fill'></i>{{LNG['explorer.app.openWindow']}}"
			}
		},
		"menuAdd":{
			"type":"switch",
			"value":1,
			"display":"{{LNG['admin.plugin.menuAdd']}}",
			"desc":"{{LNG['admin.plugin.menuAddDesc']}}",
			"switchItem":{"0":"","1":"menuSubMenu"}
		},
		"menuSubMenu":{
			"type":"switch",
			"value":0,
			"display":"{{LNG['admin.setting.subMenu']}}",
			"desc":"{{LNG['admin.plugin.menuSubMenuDesc']}}"
		},
		"sep001":"<hr/>",
		"tokenType":{
			"type":"segment",
			"value":"lower",
			"display":"{{LNG['dl.config.tokenType']}}",
			"desc":"{{LNG['dl.config.tokenTypeDesc']}}",
			"info":{
				"num":"{{LNG['dl.config.tokenTypeNum']}}",
				"lower":"{{LNG['dl.config.tokenTypeLower']}}",
				"mixed":"{{LNG['dl.config.tokenTypeMixed']}}"
			}
		},
		"tokenLen":{
			"type":"number",
			"value":12,
			"display":"{{LNG['dl.config.tokenLen']}}",
			"desc":"{{LNG['dl.config.tokenLenDesc']}}"
		}
	}
}
